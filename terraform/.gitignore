# Local state (state now lives in S3, but ignore local copies as a safety net)
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Local .terraform directories (provider plugins, cached modules)
**/.terraform/

# Variable files that may contain secrets (db_password, notification_email)
*.tfvars
*.tfvars.json
!*.tfvars.example
*.tfstate.backup
# Crash logs
crash.log
crash.*.log
# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Lambda build artifacts generated by archive_file
**/lambda/lambda_function.zip
tfplan
*.tfplan
*plan.txt

# Ignore Terraform dependency lock files (Highly recommended for portfolio layouts)
*.terraform.lock.hcl

# OS/editor cruft
.DS_Store
*.swp
