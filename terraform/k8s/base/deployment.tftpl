apiVersion: apps/v1
kind: Deployment
metadata:
  name: employee-directory
  namespace: default
  labels:
    app: employee-directory
spec:
  replicas: 2
  selector:
    matchLabels:
      app: employee-directory
  template:
    metadata:
      labels:
        app: employee-directory
    spec:
      serviceAccountName: employee-directory
      securityContext:
        runAsUser: 1654
        runAsNonRoot: true
        fsGroup: 1654
      containers:
        - name: employee-directory
          image: "${ECR_REPOSITORY_URL}:${IMAGE_TAG}"
          ports:
            - containerPort: 8080
          env:
            - name: ASPNETCORE_ENVIRONMENT
              value: "Production"
            - name: AWS_REGION
              value: "${AWS_REGION}"
            - name: DataProtection__SecretArn
              value: "${DATA_PROTECTION_SECRET_ARN}"
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 256Mi
          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 15
            periodSeconds: 20
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: false
            capabilities:
              drop: ["ALL"]